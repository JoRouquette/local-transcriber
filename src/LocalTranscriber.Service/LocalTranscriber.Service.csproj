  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalTranscriber.Core\LocalTranscriber.Core.csproj" />
    <ProjectReference Include="..\LocalTranscriber.Mcp\LocalTranscriber.Mcp.csproj" />
  </ItemGroup>

</Project>
