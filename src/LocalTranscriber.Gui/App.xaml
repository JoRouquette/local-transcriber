<Application x:Class="LocalTranscriber.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:LocalTranscriber.Gui.ViewModels"
             xmlns:pages="clr-namespace:LocalTranscriber.Gui.Views.Pages">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- BaseTheme="Inherit" : suit le thème clair/sombre de Windows. -->
                <materialDesign:BundledTheme BaseTheme="Inherit"
                                             PrimaryColor="Indigo"
                                             SecondaryColor="Teal"
                                             ColorAdjustment="{materialDesign:ColorAdjustment}" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Association ViewModel de page -> Vue (navigation par contenu). -->
            <DataTemplate DataType="{x:Type vm:GeneralViewModel}">
                <pages:GeneralPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
                <pages:ProjectsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServiceViewModel}">
                <pages:ServicePage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <pages:AboutPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
