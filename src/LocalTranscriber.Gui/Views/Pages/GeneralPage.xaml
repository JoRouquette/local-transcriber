<UserControl
  x:Class="LocalTranscriber.Gui.Views.Pages.GeneralPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
      <!-- Dossiers -->
      <materialDesign:Card
        Padding="20"
        Margin="0,0,0,16"
        materialDesign:ElevationAssist.Elevation="Dp2"
      >
        <StackPanel>
          <TextBlock Text="Dossiers" FontSize="16" FontWeight="Medium" Margin="0,0,0,12" />

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              Grid.Column="0"
              Style="{StaticResource MaterialDesignFloatingHintTextBox}"
              materialDesign:HintAssist.Hint="Dossier surveillé (Inbox)"
              Text="{Binding WatchRoot, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
            />
            <Button
              Grid.Column="1"
              Style="{StaticResource MaterialDesignIconButton}"
              Command="{Binding BrowseWatchCommand}"
              ToolTip="Parcourir"
              VerticalAlignment="Bottom"
            >
              <materialDesign:PackIcon Kind="FolderOpen" />
            </Button>
          </Grid>

          <TextBlock
            Text="{Binding WatchRootWarning}"
            Foreground="#FB8C00"
            FontSize="11"
            Margin="0,2,0,0"
          >
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding WatchRootWarning}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              Grid.Column="0"
              Style="{StaticResource MaterialDesignFloatingHintTextBox}"
              materialDesign:HintAssist.Hint="Dossier de sortie (Outputs)"
              Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
            />
            <Button
              Grid.Column="1"
              Style="{StaticResource MaterialDesignIconButton}"
              Command="{Binding BrowseOutputCommand}"
              ToolTip="Parcourir"
              VerticalAlignment="Bottom"
            >
              <materialDesign:PackIcon Kind="FolderOpen" />
            </Button>
          </Grid>

          <TextBlock
            Text="{Binding OutputRootWarning}"
            Foreground="#FB8C00"
            FontSize="11"
            Margin="0,2,0,0"
          >
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding OutputRootWarning}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBox
            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
            materialDesign:HintAssist.Hint="Cache des modèles"
            Text="{Binding ModelCacheDir, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,8,0,0"
          />
        </StackPanel>
      </materialDesign:Card>

      <!-- Moteur -->
      <materialDesign:Card
        Padding="20"
        Margin="0,0,0,16"
        materialDesign:ElevationAssist.Elevation="Dp2"
      >
        <StackPanel>
          <TextBlock
            Text="Moteur (valeurs par défaut)"
            FontSize="16"
            FontWeight="Medium"
            Margin="0,0,0,12"
          />
          <!-- Combos adaptatifs : 2 par ligne en large, 1 par ligne en étroit -->
          <WrapPanel>
            <ComboBox
              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
              materialDesign:HintAssist.Hint="Modèle"
              MinWidth="240"
              Width="260"
              Margin="0,0,12,12"
              ItemsSource="{Binding ModelSizes}"
              SelectedItem="{Binding ModelSize}"
            />
            <ComboBox
              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
              materialDesign:HintAssist.Hint="Périphérique"
              MinWidth="240"
              Width="260"
              Margin="0,0,12,12"
              ItemsSource="{Binding Devices}"
              SelectedItem="{Binding Device}"
            />
            <ComboBox
              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
              materialDesign:HintAssist.Hint="Type de calcul"
              MinWidth="240"
              Width="260"
              Margin="0,0,12,12"
              ItemsSource="{Binding ComputeTypes}"
              SelectedItem="{Binding ComputeType}"
            />
            <ComboBox
              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
              materialDesign:HintAssist.Hint="Langue"
              MinWidth="240"
              Width="260"
              Margin="0,0,12,12"
              ItemsSource="{Binding Languages}"
              SelectedItem="{Binding Language}"
            />
          </WrapPanel>
        </StackPanel>
      </materialDesign:Card>

      <!-- File de traitement -->
      <materialDesign:Card
        Padding="20"
        Margin="0,0,0,16"
        materialDesign:ElevationAssist.Elevation="Dp2"
      >
        <StackPanel>
          <TextBlock
            Text="File de traitement"
            FontSize="16"
            FontWeight="Medium"
            Margin="0,0,0,12"
          />
          <DockPanel LastChildFill="False" Margin="0,6">
            <ToggleButton
              DockPanel.Dock="Right"
              Style="{StaticResource MaterialDesignSwitchToggleButton}"
              VerticalAlignment="Center"
              Foreground="{DynamicResource PrimaryHueMidBrush}"
              IsChecked="{Binding AutoRetryFailedJobs}"
            />
            <TextBlock
              DockPanel.Dock="Left"
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{DynamicResource MaterialDesignBody}"
              Text="Réessayer automatiquement les fichiers en échec"
            />
          </DockPanel>
          <StackPanel
            Orientation="Horizontal"
            Margin="0,8,0,0"
            IsEnabled="{Binding AutoRetryFailedJobs}"
          >
            <TextBlock Text="Tentatives maximum" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox
              Width="72"
              Style="{StaticResource MaterialDesignTextBox}"
              Text="{Binding MaxAutoRetries, UpdateSourceTrigger=LostFocus}"
              VerticalAlignment="Center"
            />
          </StackPanel>
          <TextBlock
            Text="Désactivé, les échecs restent en « Failed » et se relancent à la main (bouton Retraiter). Le compteur inclut la tentative initiale."
            Foreground="{DynamicResource MaterialDesignBodyLight}"
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,8,0,0"
          />
        </StackPanel>
      </materialDesign:Card>

      <!-- Diarisation & locuteurs -->
      <materialDesign:Card
        Padding="20"
        Margin="0,0,0,16"
        materialDesign:ElevationAssist.Elevation="Dp2"
      >
        <StackPanel>
          <TextBlock
            Text="Diarisation &amp; locuteurs"
            FontSize="16"
            FontWeight="Medium"
            Margin="0,0,0,12"
          />

          <PasswordBox
            Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}"
            materialDesign:HintAssist.Hint="Jeton Hugging Face (hf_…)"
            materialDesign:PasswordBoxAssist.Password="{Binding HfToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          />
          <TextBlock
            Text="Gratuit : compte Hugging Face → accepter les conditions pyannote → token 'read'. Stocké localement (config.local.json), hors dépôt."
            Foreground="{DynamicResource MaterialDesignBodyLight}"
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,4,0,12"
          />

          <DockPanel LastChildFill="False" Margin="0,6">
            <ToggleButton
              DockPanel.Dock="Right"
              Style="{StaticResource MaterialDesignSwitchToggleButton}"
              VerticalAlignment="Center"
              Foreground="{DynamicResource PrimaryHueMidBrush}"
              IsChecked="{Binding DiarizationEnabled}"
            />
            <TextBlock
              DockPanel.Dock="Left"
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{DynamicResource MaterialDesignBody}"
              Text="Diarisation (qui parle quand)"
            />
          </DockPanel>
          <DockPanel LastChildFill="False" Margin="0,6">
            <ToggleButton
              DockPanel.Dock="Right"
              Style="{StaticResource MaterialDesignSwitchToggleButton}"
              VerticalAlignment="Center"
              Foreground="{DynamicResource PrimaryHueMidBrush}"
              IsChecked="{Binding SpeakerIdEnabled}"
            />
            <TextBlock
              DockPanel.Dock="Left"
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{DynamicResource MaterialDesignBody}"
              Text="Identifier les locuteurs (snippets de voix)"
            />
          </DockPanel>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
            <TextBlock Text="Nombre de locuteurs" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox
              Width="80"
              materialDesign:HintAssist.Hint="0 = auto"
              Style="{StaticResource MaterialDesignFloatingHintTextBox}"
              Text="{Binding SpeakerCount, UpdateSourceTrigger=PropertyChanged}"
            />
            <TextBlock
              Text="(0 = auto : déduit du dossier voices si présent, sinon détection ; une valeur force ce nombre exact)"
              VerticalAlignment="Center"
              Margin="12,0,0,0"
              FontSize="11"
              Foreground="{DynamicResource MaterialDesignBodyLight}"
            />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Seuil de similarité" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider
              Width="200"
              Minimum="0.3"
              Maximum="0.9"
              TickFrequency="0.05"
              Value="{Binding SpeakerThreshold}"
              VerticalAlignment="Center"
            />
            <TextBlock
              Text="{Binding SpeakerThreshold, StringFormat=N2}"
              VerticalAlignment="Center"
              Margin="12,0,0,0"
            />
          </StackPanel>
        </StackPanel>
      </materialDesign:Card>

      <!-- Heures d'inactivité -->
      <materialDesign:Card Padding="20" materialDesign:ElevationAssist.Elevation="Dp2">
        <StackPanel>
          <TextBlock
            Text="Heures d'inactivité"
            FontSize="16"
            FontWeight="Medium"
            Margin="0,0,0,4"
          />
          <TextBlock
            Text="Aucune transcription n'est lancée pendant ces plages (la détection continue). Jours : mon,tue,wed,thu,fri,sat,sun — vide = tous les jours. Heures au format HH:mm (fin &lt; début = passe minuit)."
            Foreground="{DynamicResource MaterialDesignBodyLight}"
            FontSize="11"
            TextWrapping="Wrap"
            Margin="0,0,0,12"
          />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button
              Style="{StaticResource MaterialDesignOutlinedButton}"
              Command="{Binding AddQuietPeriodCommand}"
              Margin="0,0,8,0"
            >
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="Ajouter une plage" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button
              Style="{StaticResource MaterialDesignFlatButton}"
              Command="{Binding RemoveQuietPeriodCommand}"
              Content="Supprimer"
            />
          </StackPanel>

          <DataGrid
            ItemsSource="{Binding QuietHours}"
            SelectedItem="{Binding SelectedQuietPeriod}"
            Style="{StaticResource MaterialDesignDataGrid}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            MaxHeight="200"
          >
            <DataGrid.Columns>
              <DataGridTextColumn
                Header="Jours"
                Binding="{Binding DaysText, UpdateSourceTrigger=LostFocus}"
                Width="2*"
              />
              <DataGridTextColumn
                Header="Début"
                Binding="{Binding Start, UpdateSourceTrigger=LostFocus}"
                Width="*"
              />
              <DataGridTextColumn
                Header="Fin"
                Binding="{Binding End, UpdateSourceTrigger=LostFocus}"
                Width="*"
              />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </materialDesign:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
