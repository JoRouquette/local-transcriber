<UserControl x:Class="LocalTranscriber.Gui.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="Microphone" Width="44" Height="44" VerticalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LocalTranscriber" FontSize="22" FontWeight="Medium" />
                    <TextBlock Text="{Binding Version, StringFormat=Version {0}}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                </StackPanel>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Transcription et diarisation locales et gratuites : surveille un dossier, transcrit/diarise les audios, indexe les sorties (recherche hybride) et les expose à Claude Desktop via un serveur MCP." />

            <materialDesign:Card Padding="16" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="Endpoint MCP (HTTP local)" FontWeight="Medium" />
                    <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Padding="0,4"
                            Command="{Binding OpenMcpCommand}" Content="{Binding McpEndpoint}" />

                    <Separator Margin="0,8" />

                    <TextBlock Text="Dépôt du projet" FontWeight="Medium" />
                    <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Padding="0,4"
                            Command="{Binding OpenRepositoryCommand}" Content="{Binding RepositoryUrl}" />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
