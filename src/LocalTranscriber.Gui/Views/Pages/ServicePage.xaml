<UserControl
  x:Class="LocalTranscriber.Gui.Views.Pages.ServicePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
>
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Traitements et fichiers" FontSize="20" FontWeight="Medium" />

      <!-- Moteur Python : état (3 états), mise à jour / réinstallation propre, journal -->
      <materialDesign:Card
        Grid.Row="1"
        Padding="16,12"
        Margin="0,12,0,0"
        materialDesign:ElevationAssist.Elevation="Dp2"
      >
        <StackPanel>
          <WrapPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
              <materialDesign:PackIcon
                Width="18"
                Height="18"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
              >
                <materialDesign:PackIcon.Style>
                  <Style TargetType="materialDesign:PackIcon">
                    <!-- Non installé -->
                    <Setter Property="Kind" Value="AlertCircle" />
                    <Setter Property="Foreground" Value="#E53935" />
                    <Style.Triggers>
                      <!-- Installé mais obsolète -->
                      <DataTrigger Binding="{Binding EngineReady}" Value="True">
                        <Setter Property="Kind" Value="Update" />
                        <Setter Property="Foreground" Value="#FB8C00" />
                      </DataTrigger>
                      <!-- Installé et à jour -->
                      <DataTrigger Binding="{Binding EngineUpToDate}" Value="True">
                        <Setter Property="Kind" Value="CheckCircle" />
                        <Setter Property="Foreground" Value="#4CAF50" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </materialDesign:PackIcon.Style>
              </materialDesign:PackIcon>
              <TextBlock
                Text="{Binding EngineStatus}"
                VerticalAlignment="Center"
                FontWeight="Medium"
              />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
              <Button
                Style="{StaticResource MaterialDesignRaisedButton}"
                Command="{Binding UpdateEngineCommand}"
                IsEnabled="{Binding CanRunEngineSetup}"
                Content="Mettre à jour"
                ToolTip="Resynchronise les dépendances Python (rapide)."
                Margin="0,0,8,0"
              />
              <Button
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Command="{Binding ReinstallEngineCommand}"
                IsEnabled="{Binding CanRunEngineSetup}"
                Content="Réinstaller proprement"
                ToolTip="Efface puis recrée l'environnement de zéro (plusieurs minutes)."
              />
            </WrapPanel>
          </WrapPanel>

          <ProgressBar
            Style="{StaticResource MaterialDesignLinearProgressBar}"
            IsIndeterminate="True"
            Margin="0,10,0,0"
            Visibility="{Binding IsInstallingEngine, Converter={StaticResource BoolToVis}}"
          />

          <!-- Journal : reste visible tant qu'il n'est pas vide (donc après un échec) -->
          <DockPanel
            Margin="0,10,0,0"
            Visibility="{Binding HasEngineLog, Converter={StaticResource BoolToVis}}"
          >
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <TextBlock
                Text="Journal d'installation"
                FontSize="12"
                FontWeight="Medium"
                VerticalAlignment="Center"
              />
              <Button
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Style="{StaticResource MaterialDesignFlatButton}"
                Command="{Binding CopyEngineLogCommand}"
                Padding="6,2"
                MinHeight="0"
              >
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon
                    Kind="ContentCopy"
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                  />
                  <TextBlock Text="Copier" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
              </Button>
            </DockPanel>
            <TextBox
              Text="{Binding EngineSetupLog, Mode=OneWay}"
              IsReadOnly="True"
              FontFamily="Consolas"
              FontSize="11"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto"
              MaxHeight="200"
            />
          </DockPanel>
        </StackPanel>
      </materialDesign:Card>

      <!-- Worker : état + actions (boutons selon l'état, transition explicite) -->
      <materialDesign:Card
        Grid.Row="2"
        Padding="16,12"
        Margin="0,12"
        materialDesign:ElevationAssist.Elevation="Dp2"
      >
        <StackPanel>
          <WrapPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
              <materialDesign:PackIcon
                Kind="Circle"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
              >
                <materialDesign:PackIcon.Style>
                  <Style TargetType="materialDesign:PackIcon">
                    <!-- Par défaut : gris (arrêté / non installé) -->
                    <Setter Property="Foreground" Value="#9E9E9E" />
                    <Style.Triggers>
                      <!-- En cours : vert -->
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Foreground" Value="#4CAF50" />
                      </DataTrigger>
                      <!-- Transition : ambre (priorité sur les autres) -->
                      <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="Foreground" Value="#FB8C00" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </materialDesign:PackIcon.Style>
              </materialDesign:PackIcon>
              <TextBlock
                Text="{Binding ServiceStatus}"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                FontWeight="Medium"
              />
              <!-- Libellé de transition (Démarrage… / Arrêt… / Redémarrage…) -->
              <TextBlock
                Text="{Binding WorkerBusyLabel}"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                FontStyle="Italic"
                Foreground="#FB8C00"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
              />
            </StackPanel>

            <WrapPanel Orientation="Horizontal">
              <!-- Non installé -->
              <Button
                Style="{StaticResource MaterialDesignRaisedButton}"
                Command="{Binding InstallServiceCommand}"
                Content="Installer"
                Margin="0,0,8,0"
                Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}"
              />
              <!-- Arrêté -->
              <Button
                Style="{StaticResource MaterialDesignRaisedButton}"
                Command="{Binding StartServiceCommand}"
                Margin="0,0,8,0"
                Visibility="{Binding IsStopped, Converter={StaticResource BoolToVis}}"
              >
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="Démarrer" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- En cours : Redémarrer + Arrêter -->
              <Button
                Style="{StaticResource MaterialDesignRaisedButton}"
                Command="{Binding RestartServiceCommand}"
                Margin="0,0,8,0"
                Visibility="{Binding IsRunningState, Converter={StaticResource BoolToVis}}"
              >
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon
                    Kind="Restart"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                  />
                  <TextBlock Text="Redémarrer" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Command="{Binding StopServiceCommand}"
                Margin="0,0,8,0"
                Visibility="{Binding IsRunningState, Converter={StaticResource BoolToVis}}"
              >
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon Kind="Stop" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBlock Text="Arrêter" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button
                Style="{StaticResource MaterialDesignIconButton}"
                Command="{Binding RefreshCommand}"
                ToolTip="Rafraîchir"
              >
                <materialDesign:PackIcon Kind="Refresh" />
              </Button>
            </WrapPanel>
          </WrapPanel>

          <!-- Barre de progression pendant une transition worker -->
          <ProgressBar
            Style="{StaticResource MaterialDesignLinearProgressBar}"
            IsIndeterminate="True"
            Margin="0,10,0,0"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
          />
        </StackPanel>
      </materialDesign:Card>

      <!-- Monitoring de la file + santé des services -->
      <materialDesign:Card
        Grid.Row="3"
        Padding="16,12"
        Margin="0,0,0,12"
        materialDesign:ElevationAssist.Elevation="Dp2"
      >
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock
              Text="Suivi de la file d'attente"
              FontWeight="Medium"
              VerticalAlignment="Center"
            />
            <!-- Santé MCP + sidecar -->
            <StackPanel
              DockPanel.Dock="Right"
              Orientation="Horizontal"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
            >
              <materialDesign:PackIcon
                Kind="Circle"
                Width="12"
                Height="12"
                VerticalAlignment="Center"
              >
                <materialDesign:PackIcon.Style>
                  <Style TargetType="materialDesign:PackIcon">
                    <Setter Property="Foreground" Value="#9E9E9E" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding McpHealthy}" Value="True">
                        <Setter Property="Foreground" Value="#4CAF50" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </materialDesign:PackIcon.Style>
              </materialDesign:PackIcon>
              <TextBlock Text="MCP" VerticalAlignment="Center" Margin="4,0,16,0" FontSize="12" />
              <materialDesign:PackIcon
                Kind="Circle"
                Width="12"
                Height="12"
                VerticalAlignment="Center"
              >
                <materialDesign:PackIcon.Style>
                  <Style TargetType="materialDesign:PackIcon">
                    <Setter Property="Foreground" Value="#9E9E9E" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SidecarHealthy}" Value="True">
                        <Setter Property="Foreground" Value="#4CAF50" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </materialDesign:PackIcon.Style>
              </materialDesign:PackIcon>
              <TextBlock
                Text="Sidecar embeddings"
                VerticalAlignment="Center"
                Margin="4,0,0,0"
                FontSize="12"
              />
            </StackPanel>
          </DockPanel>

          <WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
              <materialDesign:PackIcon
                Kind="TrayFull"
                VerticalAlignment="Center"
                Margin="0,0,6,0"
                Foreground="#9E9E9E"
              />
              <TextBlock Text="En attente : " VerticalAlignment="Center" />
              <TextBlock
                Text="{Binding PendingCount}"
                FontWeight="Bold"
                VerticalAlignment="Center"
              />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
              <materialDesign:PackIcon
                Kind="Cog"
                VerticalAlignment="Center"
                Margin="0,0,6,0"
                Foreground="#1E88E5"
              />
              <TextBlock Text="En cours : " VerticalAlignment="Center" />
              <TextBlock
                Text="{Binding ProcessingCount}"
                FontWeight="Bold"
                VerticalAlignment="Center"
              />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
              <materialDesign:PackIcon
                Kind="CheckCircle"
                VerticalAlignment="Center"
                Margin="0,0,6,0"
                Foreground="#4CAF50"
              />
              <TextBlock Text="Terminés : " VerticalAlignment="Center" />
              <TextBlock Text="{Binding DoneCount}" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
              <materialDesign:PackIcon
                Kind="AlertCircle"
                VerticalAlignment="Center"
                Margin="0,0,6,0"
                Foreground="#E53935"
              />
              <TextBlock Text="Échecs : " VerticalAlignment="Center" />
              <TextBlock
                Text="{Binding FailedCount}"
                FontWeight="Bold"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </WrapPanel>

          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Bloc d'info : libellé et durée en Auto, seul le chemin se tronque -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Text="Fichier en cours : "
                VerticalAlignment="Center"
                Foreground="{DynamicResource MaterialDesignBodyLight}"
              />
              <TextBlock
                Grid.Column="1"
                Text="{Binding CurrentFile}"
                FontWeight="Medium"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding CurrentFile}"
              />
              <TextBlock
                Grid.Column="2"
                Text="{Binding CurrentElapsed}"
                VerticalAlignment="Center"
                Margin="10,0,0,0"
                Foreground="{DynamicResource MaterialDesignBodyLight}"
              />
            </Grid>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
              <Button
                Style="{StaticResource MaterialDesignFlatButton}"
                Command="{Binding ReprocessFileCommand}"
                ToolTip="Retraiter le fichier sélectionné dans la liste ci-dessous"
                Margin="0,0,4,0"
              >
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon
                    Kind="Restart"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                  />
                  <TextBlock Text="Retraiter" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button
                Style="{StaticResource MaterialDesignFlatButton}"
                Command="{Binding OpenOutputFolderCommand}"
                ToolTip="Ouvrir le dossier de sortie du fichier sélectionné (ou le dossier racine)"
                Margin="0,0,4,0"
              >
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon
                    Kind="FolderOpen"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                  />
                  <TextBlock Text="Ouvrir le dossier" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button
                Style="{StaticResource MaterialDesignFlatButton}"
                Command="{Binding CancelCurrentCommand}"
                ToolTip="Interrompre le traitement en cours"
                Foreground="#E53935"
              >
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon
                    Kind="StopCircleOutline"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                  />
                  <TextBlock Text="Annuler" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </Grid>

          <TextBlock
            Text="{Binding LastError}"
            Foreground="#E53935"
            TextWrapping="Wrap"
            FontSize="12"
            Margin="0,6,0,0"
          />
        </StackPanel>
      </materialDesign:Card>

      <!-- Journal live + liste des fichiers -->
      <Grid Grid.Row="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <materialDesign:Card
          Grid.Row="0"
          Padding="12,10"
          Margin="0,0,0,12"
          materialDesign:ElevationAssist.Elevation="Dp2"
        >
          <StackPanel>
            <TextBlock
              Text="Journal du traitement (temps réel)"
              FontWeight="Medium"
              Margin="0,0,0,6"
            />
            <TextBox
              Text="{Binding LiveLog, Mode=OneWay}"
              TextChanged="LiveLog_TextChanged"
              IsReadOnly="True"
              FontFamily="Consolas"
              FontSize="11"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto"
              Height="150"
              Background="{DynamicResource MaterialDesignTextFieldBoxBackground}"
            />
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2">
          <DataGrid
            ItemsSource="{Binding Jobs}"
            SelectedItem="{Binding SelectedJob}"
            Style="{StaticResource MaterialDesignDataGrid}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            MaxHeight="420"
          >
            <DataGrid.Columns>
              <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="Auto" />
              <DataGridTextColumn Header="Fichier" Binding="{Binding AudioPath}" Width="3*" />
              <DataGridTextColumn Header="Durée" Binding="{Binding DurationText}" Width="Auto" />
              <DataGridTextColumn
                Header="Mis à jour"
                Binding="{Binding UpdatedAt, StringFormat=g}"
                Width="Auto"
              />
              <DataGridTextColumn Header="Erreur" Binding="{Binding Error}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
        </materialDesign:Card>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
