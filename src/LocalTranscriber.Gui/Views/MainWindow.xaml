<Window
  x:Class="LocalTranscriber.Gui.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:tb="http://www.hardcodet.net/taskbar"
  Title="LocalTranscriber"
  Height="720"
  Width="1040"
  MinHeight="600"
  MinWidth="900"
  SizeChanged="Window_SizeChanged"
  Icon="pack://application:,,,/Assets/app.ico"
  WindowStartupLocation="CenterScreen"
  Style="{StaticResource MaterialDesignWindow}"
  Background="{DynamicResource MaterialDesignPaper}"
  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
  FontFamily="{materialDesign:MaterialDesignFont}"
>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Icône de zone de notification (tray) -->
    <tb:TaskbarIcon
      x:Name="TrayIcon"
      IconSource="pack://application:,,,/Assets/app.ico"
      ToolTipText="LocalTranscriber"
      TrayMouseDoubleClick="Tray_ShowWindow"
    >
      <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Ouvrir" Click="Tray_ShowWindow" />
          <Separator />
          <MenuItem Header="Démarrer le service" Click="Tray_StartService" />
          <MenuItem Header="Arrêter le service" Click="Tray_StopService" />
          <Separator />
          <MenuItem Header="Quitter" Click="Tray_Quit" />
        </ContextMenu>
      </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>

    <!-- Barre d'application -->
    <materialDesign:ColorZone
      Grid.Row="0"
      Mode="PrimaryDark"
      Padding="16,10"
      materialDesign:ElevationAssist.Elevation="Dp4"
    >
      <DockPanel>
        <materialDesign:PackIcon
          Kind="Microphone"
          Width="26"
          Height="26"
          VerticalAlignment="Center"
        />
        <TextBlock
          Text="LocalTranscriber"
          FontSize="18"
          FontWeight="Medium"
          VerticalAlignment="Center"
          Margin="12,0,0,0"
        />

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button
            Style="{StaticResource MaterialDesignToolButton}"
            Foreground="White"
            Command="{Binding ToggleThemeCommand}"
            ToolTip="Basculer le thème clair/sombre"
          >
            <materialDesign:PackIcon Kind="ThemeLightDark" />
          </Button>
          <Button
            Style="{StaticResource MaterialDesignToolButton}"
            Foreground="White"
            Command="{Binding ReloadCommand}"
            ToolTip="Recharger la configuration"
          >
            <materialDesign:PackIcon Kind="Refresh" />
          </Button>
          <Button
            Style="{StaticResource MaterialDesignRaisedLightButton}"
            Command="{Binding SaveCommand}"
            Margin="12,0,0,0"
          >
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon
                Kind="ContentSave"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
              />
              <TextBlock Text="Enregistrer" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </materialDesign:ColorZone>

    <!-- Corps : navigation + contenu -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <!-- Largeur pilotée par Window_SizeChanged : rail complet (224) ou icônes seules (64). -->
        <ColumnDefinition x:Name="NavColumn" Width="224" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border
        Grid.Column="0"
        Background="{DynamicResource MaterialDesignCardBackground}"
        BorderBrush="{DynamicResource MaterialDesignDivider}"
        BorderThickness="0,0,1,0"
      >
        <ListBox
          ItemsSource="{Binding NavItems}"
          SelectedItem="{Binding SelectedNavItem}"
          Style="{StaticResource MaterialDesignNavigationPrimaryListBox}"
          Padding="0,8"
        >
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- ToolTip = titre : reste accessible quand le rail est réduit aux icônes. -->
              <StackPanel Orientation="Horizontal" Margin="4,10" ToolTip="{Binding Title}">
                <materialDesign:PackIcon
                  Kind="{Binding Icon}"
                  Width="22"
                  Height="22"
                  VerticalAlignment="Center"
                  Margin="4,0,14,0"
                />
                <!-- Libellé masqué quand le rail est réduit (largeur de fenêtre faible). -->
                <TextBlock
                  Text="{Binding Title}"
                  VerticalAlignment="Center"
                  FontSize="14"
                  TextTrimming="CharacterEllipsis"
                  Visibility="{Binding DataContext.IsRailExpanded, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}"
                />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

      <materialDesign:Snackbar
        Grid.Column="1"
        MessageQueue="{Binding MessageQueue}"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Center"
        Margin="0,0,0,16"
      />
    </Grid>
  </Grid>
</Window>
