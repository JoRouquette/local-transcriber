{
  "watch_root": "C:\\Transcriptions\\Inbox",
  "output_root": "C:\\Transcriptions\\Outputs",
  "model_cache_dir": "%LOCALAPPDATA%\\LocalTranscriber\\models",
  "data_dir": "%LOCALAPPDATA%\\LocalTranscriber\\data",
  "engine_executable": "engine\\transcriber-engine.exe",
  "hf_token": "",
  "file_types": [ ".wav", ".mp3", ".m4a", ".flac", ".ogg", ".opus", ".wma", ".aac" ],
  "stabilization_seconds": 5,
  "max_parallel_jobs": 1,
  "mcp_port": 8765,
  "semantic_enabled": true,
  "embedding_sidecar_port": 8766,
  "embedding_model": "intfloat/multilingual-e5-small",
  "embedding_device": "cpu",
  "chunk_max_chars": 800,
  "chunk_overlap_segments": 1,
  "engine": {
    "model_size": "large-v3",
    "device": "auto",
    "compute_type": "auto",
    "batch_size": 16,
    "language": "auto"
  },
  "diarization": {
    "enabled": true,
    "min_speakers": null,
    "max_speakers": null
  },
  "speaker_identification": {
    "enabled": false,
    "threshold": 0.55,
    "voices_dir_name": "voices"
  },
  "outputs": {
    "markdown": true,
    "json": true,
    "srt": true,
    "text": true
  },
  "projects": [
    {
      "name": "Exemple - Reunions",
      "relative_path": "Reunions",
      "enabled": true,
      "engine": { "model_size": "medium" },
      "speaker_identification": { "enabled": true, "voices_dir_name": "voices" }
    }
  ],
  "quiet_hours": [
    { "days": [ "mon", "tue", "wed", "thu", "fri" ], "start": "20:00", "end": "07:00" },
    { "days": [ "sat", "sun" ], "start": "00:00", "end": "23:59" }
  ]
}
